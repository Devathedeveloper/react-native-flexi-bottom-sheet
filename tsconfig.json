{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "jsx": "react",
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "react-native-flexi-bottom-sheet": ["./src"],
      "react-native-flexi-bottom-sheet/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "example/**/*", "__tests__/**/*"]
}
